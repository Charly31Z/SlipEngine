{
  "name": "slipengine",
  "version-string": "0.1.0",
  "dependencies": [
    "glm",
    {
      "name": "sdl2",
      "features": [
        "vulkan"
      ]
    },
    "glad",
    "vulkan-headers",
    "volk",
    "vulkan-memory-allocator",
    "shaderc",
    {
      "name": "imgui",
      "features": [
        "opengl3-binding",
        "vulkan-binding",
        "docking-experimental"
      ]
    },
    "assimp",
    "bullet3",
    "freetype",
    "lua",
    "sol2",
    "meshoptimizer"
  ]
}
