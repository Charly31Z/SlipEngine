#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uHdrIn;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uLdrOut;
layout(set = 0, binding = 2) uniform PostProcessUBO {
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 sunDir;
    vec4 sunColor;
    vec4 bloomParams;     // x=enabled, y=intensity, z=threshold, w=softKnee
    vec4 bloomTint;       // rgb=tint, w=radius
    vec4 lensParams;      // x=enabled, y=intensity, z=threshold, w=halo
    vec4 colorParams;     // x=exposureMul, y=contrast, z=saturation, w=temperature
    vec4 lift;            // rgb, w=tonemapMode
    vec4 gamma;           // rgb, w=vignetteIntensity
    vec4 gain;            // rgb, w=vignetteSmoothness
    vec4 colorFilter;     // rgb, w=blurRadius
    vec4 radialLetterbox; // x=radialStrength, y=centerX, z=centerY, w=letterbox
    vec4 fogParams0;      // x=enabled, y=density, z=heightFalloff, w=fogHeight
    vec4 fogParams1;      // x=startDist, y=maxDist, z=sunScattering, w=skyBlend
    vec4 fogColor;        // rgb, w=pillarbox
    ivec4 flags;          // x=outlineEnabled, y=hasGBuffer, z=fxaaEnabled, w=fxaaQuality
    vec4 exposureAdapt;  // x=auto, y=key, z=minLum, w=maxLum
} uPost;
layout(set = 0, binding = 3) uniform sampler2D uMetalEmissiveTex;
layout(set = 0, binding = 4) uniform sampler2D uDepthTex;
layout(set = 0, binding = 5) uniform sampler2D uBloomTex;

vec3 ACESFilm(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

vec3 ReinhardTone(vec3 x) {
    return clamp(x / (1.0 + x), 0.0, 1.0);
}

vec3 FilmicTone(vec3 x) {
    vec3 v = max(vec3(0.0), x - 0.004);
    return clamp((v * (6.2 * v + 0.5)) / (v * (6.2 * v + 1.7) + 0.06), 0.0, 1.0);
}

float SceneExposure() {
    float exposure = max(uPost.colorParams.x, 0.01);
    if (uPost.exposureAdapt.x <= 0.5) return exposure;

    float sumLog = 0.0;
    const int taps = 8;
    for (int y = 0; y < taps; ++y) {
        for (int x = 0; x < taps; ++x) {
            vec2 suv = (vec2(float(x), float(y)) + 0.5) / float(taps);
            vec3 sc = max(textureLod(uHdrIn, suv, 0.0).rgb, vec3(0.0));
            if (uPost.bloomParams.x > 0.5) {
                sc += max(textureLod(uBloomTex, suv, 0.0).rgb, vec3(0.0));
            }
            float sl = dot(sc, vec3(0.2126, 0.7152, 0.0722));
            sumLog += log(max(sl, 1e-4));
        }
    }
    float avgLum = exp(sumLog / float(taps * taps));
    float minLum = max(uPost.exposureAdapt.z, 1e-4);
    float maxLum = max(uPost.exposureAdapt.w, minLum + 0.001);
    avgLum = clamp(avgLum, minLum, maxLum);
    return (max(uPost.exposureAdapt.y, 0.001) / avgLum) * exposure;
}

vec3 TonemapToLdr(vec3 hdr, float exposure) {
    hdr = max(hdr, vec3(0.0)) * exposure;
    float temp = clamp(uPost.colorParams.w, -1.0, 1.0);
    hdr.r *= 1.0 + temp * 0.18;
    hdr.b *= 1.0 - temp * 0.18;
    hdr = max(hdr * uPost.gain.rgb + uPost.lift.rgb, vec3(0.0)) * uPost.colorFilter.rgb;

    int tm = int(uPost.lift.w + 0.5);
    vec3 mapped = (tm == 1) ? ReinhardTone(hdr) : ((tm == 2) ? FilmicTone(hdr) : ACESFilm(hdr));
    vec3 ldr = pow(mapped, vec3(1.0 / 2.2) / max(uPost.gamma.rgb, vec3(0.1)));
    ldr = clamp((ldr - vec3(0.5)) * uPost.colorParams.y + vec3(0.5), 0.0, 1.0);
    float luma = dot(ldr, vec3(0.2126, 0.7152, 0.0722));
    return clamp(mix(vec3(luma), ldr, uPost.colorParams.z), 0.0, 1.0);
}

float LdrLuma(vec3 c) {
    return sqrt(max(dot(c, vec3(0.299, 0.587, 0.114)), 0.0));
}

vec3 SampleLdr(vec2 uv, float exposure) {
    vec3 hdr = max(textureLod(uHdrIn, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb, vec3(0.0));
    if ((uPost.bloomParams.x > 0.5 && uPost.bloomParams.y > 0.001) ||
        (uPost.lensParams.x > 0.5 && uPost.lensParams.y > 0.001)) {
        vec3 bloom = max(textureLod(uBloomTex, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb, vec3(0.0));
        if (!any(isnan(bloom)) && !any(isinf(bloom))) hdr += bloom;
    }
    return TonemapToLdr(hdr, exposure);
}

vec3 ApplyFxaaLdr(ivec2 pix, ivec2 size, vec3 center, float exposure) {
    if (uPost.flags.z == 0) return center;

    int quality = clamp(uPost.flags.w, 0, 2);
    int searchSteps = (quality <= 0) ? 6 : ((quality == 1) ? 10 : 16);
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(pix) + 0.5) / vec2(size);

    float lumaM = LdrLuma(center);
    float lumaN = LdrLuma(SampleLdr(uv + vec2(0.0, -texel.y), exposure));
    float lumaS = LdrLuma(SampleLdr(uv + vec2(0.0,  texel.y), exposure));
    float lumaW = LdrLuma(SampleLdr(uv + vec2(-texel.x, 0.0), exposure));
    float lumaE = LdrLuma(SampleLdr(uv + vec2( texel.x, 0.0), exposure));

    float lumaMax = max(lumaM, max(max(lumaN, lumaS), max(lumaW, lumaE)));
    float lumaMin = min(lumaM, min(min(lumaN, lumaS), min(lumaW, lumaE)));
    float range = lumaMax - lumaMin;
    if (range < max(0.0312, lumaMax * 0.125)) return center;

    float lumaNW = LdrLuma(SampleLdr(uv + vec2(-texel.x, -texel.y), exposure));
    float lumaNE = LdrLuma(SampleLdr(uv + vec2( texel.x, -texel.y), exposure));
    float lumaSW = LdrLuma(SampleLdr(uv + vec2(-texel.x,  texel.y), exposure));
    float lumaSE = LdrLuma(SampleLdr(uv + vec2( texel.x,  texel.y), exposure));

    float edgeH = abs(lumaNW + lumaNE - 2.0 * lumaN) + abs(lumaW + lumaE - 2.0 * lumaM) * 2.0 + abs(lumaSW + lumaSE - 2.0 * lumaS);
    float edgeV = abs(lumaNW + lumaSW - 2.0 * lumaW) + abs(lumaN + lumaS - 2.0 * lumaM) * 2.0 + abs(lumaNE + lumaSE - 2.0 * lumaE);
    bool horizontal = edgeH >= edgeV;

    float lumaNeg = horizontal ? lumaN : lumaW;
    float lumaPos = horizontal ? lumaS : lumaE;
    float gradNeg = abs(lumaNeg - lumaM);
    float gradPos = abs(lumaPos - lumaM);
    bool pairNeg = gradNeg >= gradPos;
    float grad = max(gradNeg, gradPos);
    float lumaAvg = (lumaM + (pairNeg ? lumaNeg : lumaPos)) * 0.5;
    float gradScaled = max(grad * 0.25, 1e-4);

    vec2 along = horizontal ? vec2(texel.x, 0.0) : vec2(0.0, texel.y);
    vec2 across = horizontal ? vec2(0.0, texel.y) : vec2(texel.x, 0.0);
    if (pairNeg) across = -across;
    vec2 endUv = uv + across * 0.5;

    float distNeg = 1.0;
    float distPos = 1.0;
    bool doneNeg = false;
    bool donePos = false;
    for (int i = 1; i <= 16; ++i) {
        if (i > searchSteps) break;
        if (!doneNeg) {
            distNeg = float(i);
            float lNeg = LdrLuma(SampleLdr(endUv - along * float(i), exposure));
            doneNeg = abs(lNeg - lumaAvg) >= gradScaled;
        }
        if (!donePos) {
            distPos = float(i);
            float lPos = LdrLuma(SampleLdr(endUv + along * float(i), exposure));
            donePos = abs(lPos - lumaAvg) >= gradScaled;
        }
        if (doneNeg && donePos) break;
    }

    float span = max(distNeg + distPos, 1.0);
    float pixelOffset = clamp(0.5 - min(distNeg, distPos) / span, 0.0, 0.5);
    vec3 edgeSample = SampleLdr(clamp(uv + across * pixelOffset, vec2(0.0), vec2(1.0)), exposure);
    vec3 filtered = mix(center, edgeSample, clamp(pixelOffset * 2.0, 0.0, 1.0));

    float subpix = clamp((range / max(lumaMax, 1e-4) - 0.25) * 1.3333333, 0.0, 0.75);
    vec3 around = (
        SampleLdr(uv + vec2(0.0, -texel.y), exposure) +
        SampleLdr(uv + vec2(0.0,  texel.y), exposure) +
        SampleLdr(uv + vec2(-texel.x, 0.0), exposure) +
        SampleLdr(uv + vec2( texel.x, 0.0), exposure)
    ) * 0.25;
    return clamp(mix(filtered, around, subpix), 0.0, 1.0);
}

vec3 ReconstructWorldPos(vec2 uv, float depth) {
    vec4 world = uPost.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return world.xyz / max(abs(world.w), 1e-6);
}

vec3 SampleFilteredHDR(ivec2 pix, vec2 uv, ivec2 size) {
    float radStr = uPost.radialLetterbox.x;
    float blurRad = uPost.colorFilter.w;
    if (radStr <= 0.001 && blurRad <= 0.01) {
        return texelFetch(uHdrIn, pix, 0).rgb;
    }

    vec3 acc = vec3(0.0);
    float wSum = 0.0;
    if (radStr > 0.001) {
        vec2 c = uPost.radialLetterbox.yz;
        vec2 dir = (c - uv) * clamp(radStr, 0.0, 1.0) * 0.025;
        for (int i = 0; i < 6; ++i) {
            vec2 sUv = clamp(uv + dir * float(i), vec2(0.0), vec2(1.0));
            acc += textureLod(uHdrIn, sUv, 0.0).rgb;
            wSum += 1.0;
        }
    }
    if (blurRad > 0.01) {
        vec2 stepUv = (1.0 / vec2(size)) * clamp(blurRad, 0.0, 16.0);
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                vec2 sUv = clamp(uv + vec2(dx, dy) * stepUv, vec2(0.0), vec2(1.0));
                acc += textureLod(uHdrIn, sUv, 0.0).rgb;
                wSum += 1.0;
            }
        }
    }
    return acc / max(wSum, 1.0);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uLdrOut);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec3 hdr = max(SampleFilteredHDR(pix, uv, size), vec3(0.0));
    if (any(isnan(hdr)) || any(isinf(hdr))) hdr = vec3(0.0);

    // 1. Volumetric Height Fog
    if (uPost.fogParams0.x > 0.5 && uPost.flags.y != 0) {
        float depth = texelFetch(uDepthTex, pix, 0).r;
        float maxDist = max(uPost.fogParams1.y, 1.0);
        vec3 farWorld = ReconstructWorldPos(uv, 1.0);
        vec3 viewDir = normalize(farWorld - uPost.cameraPos.xyz);
        float dist = maxDist;
        float sampleY = uPost.cameraPos.y + viewDir.y * maxDist;
        if (depth < 0.99999) {
            vec3 wPos = ReconstructWorldPos(uv, depth);
            dist = min(length(wPos - uPost.cameraPos.xyz), maxDist);
            sampleY = wPos.y;
        }
        float effectiveDist = max(dist - uPost.fogParams1.x, 0.0);
        float hDelta = sampleY - uPost.fogParams0.w;
        float heightFactor = exp(-max(hDelta, 0.0) * max(uPost.fogParams0.z, 0.0));
        float fogAmt = clamp(1.0 - exp(-effectiveDist * max(uPost.fogParams0.y, 0.0) * heightFactor), 0.0, 1.0);
        if (depth >= 0.99999) {
            fogAmt *= clamp(uPost.fogParams1.w, 0.0, 1.0) * smoothstep(0.35, -0.05, viewDir.y);
        }
        float sunAmt = pow(max(dot(viewDir, normalize(uPost.sunDir.xyz)), 0.0), 8.0) * clamp(uPost.fogParams1.z, 0.0, 2.0);
        vec3 finalFog = mix(uPost.fogColor.rgb, uPost.sunColor.rgb, clamp(sunAmt, 0.0, 0.70));
        hdr = mix(hdr, finalFog, clamp(fogAmt, 0.0, 1.0));
    }

    // 2. Bloom & Lens Additive
    if ((uPost.bloomParams.x > 0.5 && uPost.bloomParams.y > 0.001) ||
        (uPost.lensParams.x > 0.5 && uPost.lensParams.y > 0.001))
    {
        vec3 bloom = max(textureLod(uBloomTex, uv, 0.0).rgb, vec3(0.0));
        if (!any(isnan(bloom)) && !any(isinf(bloom))) {
            hdr += bloom;
        }
    }

    // 3. Exposure + tonemap. FXAA corre sobre la imagen ya mapeada (0..1), igual que en OpenGL.
    float exposure = SceneExposure();
    vec3 ldr = TonemapToLdr(hdr, exposure);
    if (uPost.radialLetterbox.x <= 0.001 && uPost.colorFilter.w <= 0.01) {
        ldr = ApplyFxaaLdr(pix, size, ldr, exposure);
    }

    // 6. Vignette
    if (uPost.gamma.w > 0.001) {
        float distC = length(uv - vec2(0.5)) * 1.41421356;
        float innerR = clamp(0.85 - uPost.gain.w * 0.55, 0.05, 0.85);
        float vig = smoothstep(1.05, innerR, distC);
        ldr *= mix(1.0 - clamp(uPost.gamma.w, 0.0, 1.0), 1.0, vig);
    }

    // 7. Letterbox & Pillarbox
    if (uPost.radialLetterbox.w > 0.001 && (uv.y < uPost.radialLetterbox.w || uv.y > 1.0 - uPost.radialLetterbox.w)) {
        ldr = vec3(0.0);
    }
    if (uPost.fogColor.w > 0.001 && (uv.x < uPost.fogColor.w || uv.x > 1.0 - uPost.fogColor.w)) {
        ldr = vec3(0.0);
    }

    // 8. Screen-Space Selection Outline (#4296FA)
    if (uPost.flags.x != 0 && uPost.flags.y != 0) {
        float centerSel = (texelFetch(uMetalEmissiveTex, pix, 0).z > 0.5) ? 1.0 : 0.0;
        if (centerSel < 0.5) {
            const ivec2 offsets[8] = ivec2[8](
                ivec2( 2,  0), ivec2(-2,  0), ivec2( 0,  2), ivec2( 0, -2),
                ivec2( 2,  2), ivec2(-2,  2), ivec2( 2, -2), ivec2(-2, -2)
            );
            float edge = 0.0;
            for (int i = 0; i < 8; ++i) {
                ivec2 q = clamp(pix + offsets[i], ivec2(0), size - ivec2(1));
                if (texelFetch(uMetalEmissiveTex, q, 0).z > 0.5) {
                    edge = 1.0;
                    break;
                }
            }
            if (edge < 0.5) {
                const ivec2 innerOff[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
                for (int i = 0; i < 4; ++i) {
                    ivec2 q = clamp(pix + innerOff[i], ivec2(0), size - ivec2(1));
                    if (texelFetch(uMetalEmissiveTex, q, 0).z > 0.5) {
                        edge = 1.0;
                        break;
                    }
                }
            }
            if (edge > 0.5) {
                ldr = mix(ldr, vec3(0.26, 0.59, 0.98), 0.95);
            }
        }
    }

    imageStore(uLdrOut, pix, vec4(clamp(ldr, 0.0, 1.0), 1.0));
}
