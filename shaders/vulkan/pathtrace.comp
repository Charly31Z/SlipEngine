struct GpuMaterialData {
    vec4 albedoColor;
    vec4 emissiveColor;
    vec4 pbrParams;
    vec4 extraParams;
    ivec4 texIndices0;
    ivec4 texIndices1;
};

struct GpuRtInstanceInfo {
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint materialIndex;
    uint firstIndex;
    int  vertexOffset;
    uint vertexStrideFloats;
    mat4 prevModel;
};

struct GpuDirLight {
    vec4 directionIntensity;
    vec4 colorPad;
};

struct GpuPointLight {
    vec4 positionRange;
    vec4 colorIntensity;
};

struct GpuSpotLight {
    vec4 positionRange;
    vec4 directionCosOuter;
    vec4 colorIntensityCosIn;
};

struct GpuDIReservoir {
    uint  lightInfo;   // bits [0..15] = lightIdx, bits [16..19] = lightType (0=None, 1=Dir, 2=Point, 3=Spot)
    uint  M;
    float weightSum;   // during RIS: sum of weights; finalized: unbiased contribution weight W
    float targetPdf;
    vec2  lightRandUV;
    vec2  pad;
};

struct GpuGIReservoir {
    vec4 samplePosDist;     // .xyz = sampleHitPos (or skyDir if sky), .w = hitDist
    vec4 sampleNormType;    // .xyz = sampleHitNormal, .w = hitType (0=invalid, 1=surface, 2=sky)
    vec4 radianceTargetPdf; // .rgb = outgoing radiance Lo at sample point, .a = targetPdf
    vec4 weights;           // .x = W, .y = M, .z = 0, .w = 0
};

layout(set = 0, binding = 0) uniform sampler2D uTextures[];
